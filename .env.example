# Copy to .env and fill in. Any OpenAI-compatible endpoint with tool calling works.
LLM_BASE_URL=https://api.inference.wandb.ai/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.8-27B
# Request body that turns off model reasoning for fast JSON calls (vLLM/Qwen style). Set to {} for other providers.
# LLM_NO_THINK={"chat_template_kwargs": {"enable_thinking": false}}

# FalkorDB connection (docker compose sets FALKORDB_HOST=falkordb for you)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_PASSWORD=

# Only needed to regenerate the demo video narration
ELEVENLABS_API_KEY=
